# ─────────────────────────────────────────────────────────────────────
# AI Agency OS — variáveis de ambiente (copie para apps/web/.env.local)
#
# Sem as variáveis do Supabase, o app roda em MODO LOCAL: dados em memória
# no processo do servidor (perdidos ao reiniciar) e sem login.
# ─────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). URL e anon key são públicas por design;
# a proteção dos dados é feita por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDO — somente servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Provedores de IA (usados a partir da Fase 2, somente no servidor/worker).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Força o modo local mesmo com Supabase configurado (true/false).
AGENCY_FORCE_MEMORY_MODE=false
